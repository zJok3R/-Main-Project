# Stripe — Test-Keys. Echte Werte in .env (gitignored), NICHT committen.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Preis für Produkt X — wird später eingeführt.
# Ohne diesen Wert zeigt der Checkout den "Bezahlfeld wird vorbereitet"-Zustand.
STRIPE_PRICE_ID=

# Webhook-Endpoint-Secret (Dashboard → Webhooks → Signing Secret).
# Ohne diesen Wert verarbeitet /api/webhook nichts (sicherer Ausfallzustand).
STRIPE_WEBHOOK_SECRET=whsec_...
