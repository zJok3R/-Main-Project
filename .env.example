# Stripe — Test-Keys. Echte Werte in .env (gitignored), NICHT committen.
# Server-seitig (API/Webhook) — für den Payment-Link-Checkout derzeit nicht nötig.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Payment Link (gehostete Checkout-Seite, öffentliche URL).
# Ohne diesen Wert nutzt der Checkout den Default-Link im Code
# (src/components/checkout.tsx, PAYMENT_LINK-Konstante).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Fulfillment-Mails (Resend). Domain omnaut.de vorher in Resend verifizieren.
# Ohne diese Werte verarbeitet der Webhook Zahlungen, sendet aber keine Mails.
RESEND_API_KEY=
MAIL_FROM=Omnaut <kontakt@omnaut.de>
